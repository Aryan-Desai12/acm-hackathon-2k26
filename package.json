{
  "name": "dvs-extension",
  "displayName": "dvs-extension",
  "description": "Minimal Dataset Versioning System",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:dvsHistory"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dvs.openDashboard",
        "title": "DVS: Open Dashboard"
      },
      {
        "command": "dvs.compareVersions",
        "title": "DVS: Compare Dataset Versions"
      },
      {
        "command": "dvs.inspectCommit",
        "title": "DVS: Inspect Version"
      },
      {
        "command": "dvs.refreshHistory",
        "title": "DVS: Refresh History",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dvs-explorer",
          "title": "DVS",
          "icon": "$(history)"
        }
      ]
    },
    "views": {
      "dvs-explorer": [
        {
          "id": "dvsHistory",
          "name": "Dataset History"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dvs.refreshHistory",
          "when": "view == dvsHistory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dvs.inspectCommit",
          "when": "view == dvsHistory",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}